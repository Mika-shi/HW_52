@model WebApplication1.ViewModels.PhoneDetailsViewModel

@{
    ViewData["Title"] = "Phone Details";
}

<h1>Phone Details</h1>

<div>
    <h4>@Model.Phone.Name</h4>
    <hr />

    <p>
        <strong>Company:</strong> @Model.Phone.Company
    </p>

    <p>
        <strong>Price:</strong> @Model.Phone.Price
    </p>

    <p>
        <strong>Description:</strong> @Model.Phone.Description
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.Phone.ImageUrl))
    {
        <p>
            <img src="@Model.Phone.ImageUrl" alt="@Model.Phone.Name" style="max-width: 250px;" />
        </p>
    }
</div>

<hr />

<h3>Reviews</h3>

@if (Model.Reviews.Count > 0)
{
    <p>
        <strong>Average rating:</strong> @Model.AverageRating.ToString("0.0")
    </p>

    <table class="table">
        <thead>
        <tr>
            <th>Author</th>
            <th>Rating</th>
            <th>Review</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var review in Model.Reviews)
        {
            <tr>
                <td>@review.AuthorName</td>
                <td>@review.Rating</td>
                <td>@review.Text</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>There are no reviews yet.</p>
}

<hr />

<h3>Add review</h3>

<form asp-controller="Phone" asp-action="AddReview" method="post">
    <input type="hidden" asp-for="NewReview.PhoneId" />

    <div class="mb-3">
        <label asp-for="NewReview.AuthorName" class="form-label">Your name</label>
        <input asp-for="NewReview.AuthorName" class="form-control" />
        <span asp-validation-for="NewReview.AuthorName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NewReview.Text" class="form-label">Review</label>
        <textarea asp-for="NewReview.Text" class="form-control"></textarea>
        <span asp-validation-for="NewReview.Text" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NewReview.Rating" class="form-label">Rating</label>
        <select asp-for="NewReview.Rating" class="form-control">
            <option value="0">0</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
        </select>
        <span asp-validation-for="NewReview.Rating" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Add review</button>
</form>

<div class="mt-3">
    <a asp-controller="Phone" asp-action="Index">Back to list</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}