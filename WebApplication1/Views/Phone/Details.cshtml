@model WebApplication1.Models.Phone
@using WebApplication1.Models

@{
    ViewData["Title"] = "Details";
    List<CurrencyCourse> currencies = ViewBag.Currencies as List<CurrencyCourse> ?? new List<CurrencyCourse>();
}

<h1>Phone Details</h1>

<div class="row">
    <div class="col-md-5">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" style="width: 100%; max-height: 450px; object-fit: cover;" />
        }
        else
        {
            <p>No image available</p>
        }
    </div>

    <div class="col-md-7">
        <h2>@Model.Name</h2>

        <p><b>Company:</b> @Model.Company</p>

        <p><b>Price in USD:</b> $@Model.Price</p>

        <p><b>Description:</b></p>
        <p>@Model.Description</p>

        <h3>Price in other currencies</h3>

        @if (currencies.Count == 0)
        {
            <p>No currencies found.</p>
        }
        else
        {
            <table class="table">
                <thead>
                <tr>
                    <th>Currency name</th>
                    <th>Currency code</th>
                    <th>Price</th>
                </tr>
                </thead>

                <tbody>
                @foreach (var currency in currencies)
                {
                    double convertedPrice = Model.Price * currency.CurrencyRate;

                    <tr>
                        <td>@currency.CurrencyName</td>
                        <td>@currency.CurrencyCode</td>
                        <td>@convertedPrice.ToString("0.00") @currency.CurrencyCode</td>                    </tr>
                }
                </tbody>
            </table>
        }

        <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
        <a asp-action="Index">Back to List</a>
    </div>
</div>