@model List<WebApplication1.Models.Phone>

@{
    ViewData["Title"] = "Index";
}

<h1>Phones</h1>
<div>
    <a asp-action="Create">Create new Phone</a>
</div>
@if (Model.Count == 0)
{
    <p>There are no phones yet</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>
                Name
            </th>
            <th>
                Company
            </th>
            <th>
                Price
            </th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Name
                </td>
                <td>
                    @item.Company
                </td>
                <td>
                    @item.Price
                </td>
                <td>
                    <a asp-action="Create" asp-controller="Order" asp-route-id="@item.Id">Order</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | 
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

