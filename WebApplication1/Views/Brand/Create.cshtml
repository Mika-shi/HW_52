@model WebApplication1.Models.Brand

@{
    ViewData["Title"] = "Добавить бренд";
}

<h1>Добавить бренд</h1>

<form asp-action="Create" asp-controller="Brand" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Название бренда</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DateOfFoundation" class="form-label">Дата основания</label>
        <input asp-for="DateOfFoundation" type="date" class="form-control" />
        <span asp-validation-for="DateOfFoundation" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Добавить</button>
</form>

<div class="mt-3">
    <a asp-controller="Brand" asp-action="Index">Назад к списку брендов</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}